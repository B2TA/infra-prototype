# Copy this file to .env.canvas and replace every placeholder value.
# Keep .env.canvas private; it is ignored by Git.

# Used by PostgreSQL and Canvas's config/database.yml.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Used by the one-time Canvas database initialization command.
CANVAS_LMS_ADMIN_EMAIL=canvas-admin@example.com
CANVAS_LMS_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
CANVAS_LMS_ACCOUNT_NAME=B2TA Canvas
CANVAS_LMS_STATS_COLLECTION=opt_out
CANVAS_DOMAIN=canvas.example.com
CANVAS_SSL=true

# Used by config/security.yml. Use a random value of at least 20 characters.
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
JWT_ENCRYPTION_KEY=replace-with-a-different-long-random-jwt-key

# Optional. Leave the default for a Caddy reverse proxy on the same host.
# CANVAS_BIND=127.0.0.1:3000
